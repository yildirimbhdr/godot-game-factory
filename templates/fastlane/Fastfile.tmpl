default_platform(:ios)

def asc_key
  app_store_connect_api_key(
    key_id: ENV.fetch("GF_ASC_KEY_ID"),
    issuer_id: ENV.fetch("GF_ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("GF_ASC_KEY_PATH"),   # the AuthKey_XXXX.p8 file, kept outside every repo
    in_house: false
  )
end

# The app record and its newest builds. The record itself is created once by hand (New App); Apple's API cannot create it.
def asc_app_and_builds
  asc_key
  app = Spaceship::ConnectAPI::App.find("__BUNDLE__")
  UI.user_error!("No App Store Connect app record for __BUNDLE__. Create it once with New App in appstoreconnect.apple.com (same bundle id).") if app.nil?
  [app, app.get_builds(sort: "-uploadedDate", limit: 5)]
end

# A brand-new version has no App Review Information record yet and deliver fails with "No data" (fastlane issue 20538). Create an empty one;
# contact name, phone and email stay yours to enter in App Store Connect before "Add for Review".
def ensure_review_detail
  asc_key
  app = Spaceship::ConnectAPI::App.find("__BUNDLE__")
  version = app && app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
  return if version.nil?
  begin
    version.fetch_app_store_review_detail
  rescue StandardError
    version.create_app_store_review_detail(attributes: { demo_account_required: false })
    UI.message("created an empty App Review Information record")
  end
end

platform :ios do
  desc "Read-only: does the app record exist, which versions and builds does Apple have (output lines start with GF_ASC)"
  lane :status do
    app, builds = asc_app_and_builds
    UI.message("GF_ASC app_id=#{app.id} name=#{app.name}")
    app.get_app_store_versions(limit: 5).each { |v| UI.message("GF_ASC version=#{v.version_string} state=#{v.app_store_state}") }
    builds.each { |b| UI.message("GF_ASC build=#{b.version} processing=#{b.processing_state} uploaded=#{b.uploaded_date}") }
  end

  desc "Wait until a build is processed. Usage: fastlane ios wait_build build:3"
  lane :wait_build do |options|
    want = options[:build].to_s
    UI.user_error!("pass build:<number>") if want.empty?
    deadline = Time.now + 45 * 60
    loop do
      _app, builds = asc_app_and_builds
      b = builds.find { |x| x.version.to_s == want }
      UI.message("GF_ASC build=#{want} " + (b ? "processing=#{b.processing_state}" : "not visible yet"))
      break if b && b.processing_state == "VALID"
      UI.user_error!("build #{want} ended as #{b.processing_state}") if b && %w[FAILED INVALID].include?(b.processing_state)
      UI.user_error!("timed out waiting for build #{want}") if Time.now > deadline
      sleep 60
    end
  end

  desc "Attach a processed build to the editable version (deliver with skip_binary_upload does not). Usage: fastlane ios attach_build build:3"
  lane :attach_build do |options|
    app, builds = asc_app_and_builds
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!("no editable App Store version for __BUNDLE__") if version.nil?
    build = builds.find { |b| b.version.to_s == options[:build].to_s && b.processing_state == "VALID" }
    UI.user_error!("build #{options[:build]} is not processed (VALID) yet") if build.nil?
    version.select_build(build_id: build.id)
    UI.message("GF_ASC attached build=#{build.version} to version=#{version.version_string}")
  end

  desc "Texts and screenshots to App Store Connect (no review submission). Usage: fastlane ios metadata [version:1.1.0]"
  lane :metadata do |options|
    ensure_review_detail
    deliver(
      api_key: asc_key,
      app_identifier: "__BUNDLE__",
      app_version: options[:version],
      metadata_path: "fastlane/metadata",
      screenshots_path: "fastlane/screenshots",
      overwrite_screenshots: true,
      skip_binary_upload: true,
      skip_app_version_update: options[:version].nil?,
      force: true,
      submit_for_review: false,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Signed build to App Store Connect via the plugin script (Xcode signed in); ../../game-factory-godot/scripts/ios_release.sh"
  lane :build_upload do
    sh("#{ENV.fetch('GF_PLUGIN', '../../game-factory-godot')}/scripts/ios_release.sh", "..", "../build/ios_release", "--upload")
  end

  desc "Attach the processed build and submit (only when you mean it). Usage: fastlane ios submit build:3 [version:1.1.0]"
  lane :submit do |options|
    deliver(api_key: asc_key, app_identifier: "__BUNDLE__", app_version: options[:version], build_number: options[:build].to_s,
            skip_metadata: true, skip_screenshots: true, skip_binary_upload: true,
            skip_app_version_update: options[:version].nil?, submit_for_review: true, automatic_release: true, force: true,
            precheck_include_in_app_purchases: false,
            submission_information: { export_compliance_uses_encryption: false, __IDFA__ })
  end
end

platform :android do
  desc "Texts and images to Play Console"
  lane :listing do
    upload_to_play_store(package_name: "__PACKAGE__", track: "production", skip_upload_aab: true, skip_upload_apk: true,
                         skip_upload_changelogs: true, metadata_path: "fastlane/metadata/android")
  end

  desc "AAB to a track as a DRAFT (default: internal). Usage: fastlane android release aab:store/builds/x.aab track:production"
  lane :release do |options|
    upload_to_play_store(package_name: "__PACKAGE__", track: options[:track] || "internal",
                         aab: options[:aab] || Dir["../store/builds/*.aab"].max, release_status: "draft",
                         skip_upload_metadata: true, skip_upload_images: true, skip_upload_screenshots: true)
  end
end
