# Read-only probe used by gf_status.py sync-apple: any bundle id, no per-game fastlane folder needed. Lines start with GF_ASC.
default_platform(:ios)

platform :ios do
  lane :probe do
    app_store_connect_api_key(
      key_id: ENV.fetch("GF_ASC_KEY_ID"), issuer_id: ENV.fetch("GF_ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("GF_ASC_KEY_PATH"), in_house: false
    )
    app = Spaceship::ConnectAPI::App.find(ENV.fetch("GF_BUNDLE"))
    if app.nil?
      UI.message("GF_ASC none")
    else
      UI.message("GF_ASC app_id=#{app.id} name=#{app.name}")
      app.get_app_store_versions(limit: 5).each { |v| UI.message("GF_ASC version=#{v.version_string} state=#{v.app_store_state}") }
      app.get_builds(sort: "-uploadedDate", limit: 5).each { |b| UI.message("GF_ASC build=#{b.version} processing=#{b.processing_state}") }
    end
  end
end
